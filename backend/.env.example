# Copy to backend/.env and fill in LLM_API_KEY.

DATABASE_URL=postgresql://docpilot:docpilot@localhost:5432/docpilot

# Gemini (free tier) via its OpenAI-compatible endpoint. Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=

# Groq (free tier, higher limits; used for the README eval results). Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# To use OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# A local Ollama model (no key needed, but LLM_API_KEY must not be empty):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Demo API keys (dp_demo_*) for local use. Set to false anywhere real; that also revokes seeded ones.
SEED_DEMO_KEYS=true

# Retrieval tuning (measure changes with evals/run_eval.py)
# vector | hybrid (vector + keyword search, fused with RRF)
RETRIEVAL_MODE=hybrid
# Re-order the top 20 candidates with a local cross-encoder
RERANK=false
TOP_K=5
MIN_RELEVANCE=0.55
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=200
